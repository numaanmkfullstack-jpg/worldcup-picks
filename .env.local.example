# Copy this to .env.local after you create the Next.js app.
# Use the pooled Neon connection string for serverless deployments.
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require"

# Optional: direct URL for migrations or long-running scripts.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require"

# Required for signed login cookies. Generate a long random value before sharing/deploying.
AUTH_SECRET="replace-with-a-long-random-secret"

# Optional: protects the custom results API for external scripts/workers.
RESULTS_API_SECRET="replace-with-a-long-random-results-secret"

# Optional: override the official source used by the admin result scraper.
RESULTS_SCRAPE_URL="https://www.fifa.com/en/tournaments/mens/worldcup/canadamexicousa2026/scores-fixtures"
